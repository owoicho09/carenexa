// CareNexa data model.
// See CareNexa-BRIEF.md for the vocabulary this schema mirrors (Patient, Visit,
// Department, Request, Staff — kept literal on purpose).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

enum StaffRole {
  ADMIN
  RECORDS_OFFICER
  NURSE
  CLINICIAN
  LAB_SCIENTIST
  PHARMACIST
  RECEPTIONIST
  RECRUITER
}

enum IdentityVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  REVOKED
}

enum AccessGrantStatus {
  PENDING
  ACTIVE
  REVOKED
  EXPIRED
}

enum ReferralStatus {
  DRAFT
  SUBMITTED
  ACKNOWLEDGED
  UNDER_REVIEW
  MORE_INFORMATION_REQUESTED
  ACCEPTED
  DECLINED
  REDIRECTED
  APPOINTMENT_SCHEDULED
  ARRIVAL_CONFIRMED
  TREATMENT_IN_PROGRESS
  DISCHARGED
  COUNTER_REFERRAL_SUBMITTED
  COMPLETED
}

enum ClinicalInsightType {
  RISK_ASSESSMENT
  PATTERN_DETECTION
  CLINICAL_INSIGHT
  LONGITUDINAL_SUMMARY
}

model Hospital {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  staffMembers          StaffMember[]
  rolePermissions       RolePermission[]
  departments           Department[]
  cardTypes             CardType[]
  patients              Patient[]
  visits                Visit[]
  appointments          Appointment[]
  communications        Communication[]
  requests              Request[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  vacancies             Vacancy[]
  candidates            Candidate[]
  applications          Application[]
  aiArtifacts           AiArtifact[]
  patientLinks          PatientHospitalLink[]
  identityVerifications PatientIdentityVerification[]
  accessGrantsFrom      PatientAccessGrant[]          @relation("GrantSourceHospital")
  accessGrantsTo        PatientAccessGrant[]          @relation("GrantReceivingHospital")
  emergencyAccessFrom   EmergencyAccessEvent[]        @relation("EmergencySourceHospital")
  emergencyAccessTo     EmergencyAccessEvent[]        @relation("EmergencyAccessingHospital")
  referralsFrom         Referral[]                    @relation("ReferralSourceHospital")
  referralsTo           Referral[]                    @relation("ReferralDestinationHospital")
  clinicalInsights      ClinicalInsight[]
  invoices              Invoice[]
}

model StaffMember {
  id                        String      @id @default(cuid())
  fullName                  String
  email                     String      @unique
  passwordHash              String
  role                      StaffRole
  jobTitle                  String // e.g. "Consultant", "Matron", "Laboratory Scientist II"
  hospitalId                String?
  hospital                  Hospital?   @relation(fields: [hospitalId], references: [id])
  isPlatformAdmin           Boolean     @default(false)
  departmentId              String?
  department                Department? @relation(fields: [departmentId], references: [id])
  isActive                  Boolean     @default(true)
  toastNotificationsEnabled Boolean     @default(true)
  createdAt                 DateTime    @default(now())

  hiredFromCandidateId String?    @unique
  hiredFromCandidate   Candidate? @relation(fields: [hiredFromCandidateId], references: [id])

  requestsMade           Request[]                     @relation("RequestedBy")
  requestsFulfilled      Request[]                     @relation("FulfilledBy")
  vitalsRecorded         VitalsRecord[]
  notesAuthored          ClinicalNote[]
  labResultsEntered      LabResult[]
  prescriptionsMade      Prescription[]
  dispensations          Dispensation[]
  visitsOpened           Visit[]                       @relation("VisitOpenedBy")
  diagnoses              Diagnosis[]
  appointmentsBooked     Appointment[]
  notifications          Notification[]
  communicationsSent     Communication[]
  auditLogEntries        AuditLog[]
  passwordResetTokens    PasswordResetToken[]
  identityVerifications  PatientIdentityVerification[]
  accessGrantsRequested  PatientAccessGrant[]
  referralsAuthored      Referral[]
  emergencyAccessGranted EmergencyAccessEvent[]
  aiArtifactsGenerated   AiArtifact[]                  @relation("AiArtifactGeneratedBy")
  aiArtifactsApproved    AiArtifact[]                  @relation("AiArtifactApprovedBy")
  insightsReviewed       ClinicalInsight[]             @relation("ClinicalInsightReviewedBy")
  referralEvents         ReferralEvent[]
  invoicesCreated        Invoice[]                     @relation("InvoiceCreatedBy")
  paymentsReceived       Payment[]                     @relation("PaymentReceivedBy")

  @@unique([hospitalId, id])
  @@index([departmentId])
  @@index([hospitalId])
}

model RolePermission {
  id         String    @id @default(cuid())
  hospitalId String
  hospital   Hospital  @relation(fields: [hospitalId], references: [id])
  role       StaffRole
  permission String
  enabled    Boolean   @default(false)

  @@unique([hospitalId, role, permission])
  @@index([hospitalId])
}

model AuditLog {
  id          String      @id @default(cuid())
  hospitalId  String?
  hospital    Hospital?   @relation(fields: [hospitalId], references: [id])
  actorId     String
  actor       StaffMember @relation(fields: [actorId], references: [id])
  action      String // "STAFF_CREATED", "PATIENT_DELETED", "DEPARTMENT_EDITED", ...
  targetType  String // "StaffMember", "Patient", "Department", ...
  targetId    String?
  targetLabel String? // human-readable, e.g. patient name or department name
  detail      String?
  createdAt   DateTime    @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([hospitalId, createdAt])
}

model PasswordResetToken {
  id        String      @id @default(cuid())
  staffId   String
  staff     StaffMember @relation(fields: [staffId], references: [id])
  token     String      @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime    @default(now())
}

// ---------------------------------------------------------------------------
// Departments — admin-configurable at runtime, never hardcoded.
// ---------------------------------------------------------------------------

model Department {
  id                  String    @id @default(cuid())
  hospitalId          String
  hospital            Hospital  @relation(fields: [hospitalId], references: [id])
  name                String
  slug                String
  description         String
  acceptsRequestTypes String[] // free-form labels this department can receive, e.g. ["Laboratory Test", "Blood Culture"]
  resultFields        Json // shape of the outcome form this department fills in, admin-defined
  createdAt           DateTime  @default(now())
  // Removed departments are archived, not deleted, so past requests and
  // referrals keep their history. Archived departments are hidden from lists.
  isArchived          Boolean   @default(false)
  archivedAt          DateTime?

  staff                     StaffMember[]
  requestsReceived          Request[]      @relation("RequestToDepartment")
  requestsSent              Request[]      @relation("RequestFromDepartment")
  referralsSent             Referral[]     @relation("ReferralSourceDepartment")
  externalReferralsReceived Referral[]     @relation("ReferralDestinationDepartment")
  vacancies                 Vacancy[]
  appointments              Appointment[]
  notifications             Notification[]

  @@unique([hospitalId, id])
  @@unique([hospitalId, name])
  @@unique([hospitalId, slug])
  @@index([hospitalId])
}

// ---------------------------------------------------------------------------
// Patients
// ---------------------------------------------------------------------------

enum Sex {
  MALE
  FEMALE
}

enum Genotype {
  AA
  AS
  SS
  AC
  SC
}

model CardType {
  id          String                  @id @default(cuid())
  hospitalId  String
  hospital    Hospital                @relation(fields: [hospitalId], references: [id])
  name        String // "General Outpatient", "Private", "Antenatal", "Child Welfare", "Staff"
  seriesCode  String // "GOP", "PVT", "ANC", "CWC", "STF"
  description String
  counters    HospitalNumberCounter[]
  patients    Patient[]

  @@unique([hospitalId, id])
  @@unique([hospitalId, name])
  @@unique([hospitalId, seriesCode])
  @@index([hospitalId])
}

model HospitalNumberCounter {
  id         String   @id @default(cuid())
  cardTypeId String
  cardType   CardType @relation(fields: [cardTypeId], references: [id])
  year       Int
  lastNumber Int      @default(0)

  @@unique([cardTypeId, year])
}

model Patient {
  id             String   @id @default(cuid())
  hospitalId     String
  hospital       Hospital @relation(fields: [hospitalId], references: [id])
  hospitalNumber String // e.g. GOP/2026/00412
  cardTypeId     String
  cardType       CardType @relation(fields: [cardTypeId], references: [id])

  fullName    String
  dateOfBirth DateTime
  sex         Sex
  phone       String
  address     String
  bloodGroup  String? // "O+", "A-", ...
  genotype    Genotype?
  allergies   String[] // ["Penicillin", "Sulfa drugs"]

  nextOfKinName     String
  nextOfKinPhone    String
  nextOfKinRelation String

  registeredAt DateTime  @default(now())
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?

  visits                Visit[]
  appointments          Appointment[]
  communications        Communication[]
  identityLinks         PatientHospitalLink[]
  identityVerifications PatientIdentityVerification[]
  referrals             Referral[]
  clinicalInsights      ClinicalInsight[]
  invoices              Invoice[]

  @@unique([hospitalId, id])
  @@unique([hospitalId, hospitalNumber])
  @@index([hospitalId, fullName])
  @@index([hospitalId, phone])
}

model CareNexaIdentity {
  id                     String                     @id @default(cuid())
  universalPatientNumber String                     @unique
  verificationStatus     IdentityVerificationStatus @default(PENDING)
  verificationMethod     String?
  verifiedAt             DateTime?
  createdAt              DateTime                   @default(now())

  hospitalLinks         PatientHospitalLink[]
  verifications         PatientIdentityVerification[]
  accessGrants          PatientAccessGrant[]
  emergencyAccessEvents EmergencyAccessEvent[]
  referrals             Referral[]
  clinicalInsights      ClinicalInsight[]
}

model PatientHospitalLink {
  id                 String                     @id @default(cuid())
  identityId         String
  identity           CareNexaIdentity           @relation(fields: [identityId], references: [id])
  hospitalId         String
  hospital           Hospital                   @relation(fields: [hospitalId], references: [id])
  patientId          String
  patient            Patient                    @relation(fields: [patientId], references: [id])
  linkedAt           DateTime                   @default(now())
  verificationStatus IdentityVerificationStatus @default(PENDING)

  @@unique([hospitalId, patientId])
  @@unique([identityId, hospitalId])
  @@index([identityId])
}

model PatientIdentityVerification {
  id                String                     @id @default(cuid())
  identityId        String
  identity          CareNexaIdentity           @relation(fields: [identityId], references: [id])
  hospitalId        String
  hospital          Hospital                   @relation(fields: [hospitalId], references: [id])
  patientId         String
  patient           Patient                    @relation(fields: [patientId], references: [id])
  verifiedById      String
  verifiedBy        StaffMember                @relation(fields: [verifiedById], references: [id])
  status            IdentityVerificationStatus
  method            String
  evidenceReference String?
  verifiedAt        DateTime                   @default(now())
  revokedAt         DateTime?

  @@index([identityId, hospitalId, status])
  @@index([patientId])
}

model PatientAccessGrant {
  id                    String            @id @default(cuid())
  identityId            String
  identity              CareNexaIdentity  @relation(fields: [identityId], references: [id])
  sourceHospitalId      String
  sourceHospital        Hospital          @relation("GrantSourceHospital", fields: [sourceHospitalId], references: [id])
  receivingHospitalId   String
  receivingHospital     Hospital          @relation("GrantReceivingHospital", fields: [receivingHospitalId], references: [id])
  requestingStaffId     String?
  requestingStaff       StaffMember?      @relation(fields: [requestingStaffId], references: [id])
  purpose               String
  recordCategories      String[]
  status                AccessGrantStatus @default(PENDING)
  authorizationEvidence String?
  authorizedAt          DateTime?
  expiresAt             DateTime?
  revokedAt             DateTime?
  createdAt             DateTime          @default(now())
  referralId            String?
  referral              Referral?         @relation(fields: [referralId], references: [id])

  @@index([identityId, receivingHospitalId, status])
  @@index([sourceHospitalId, receivingHospitalId])
  @@index([expiresAt])
}

model EmergencyAccessEvent {
  id                  String           @id @default(cuid())
  identityId          String
  identity            CareNexaIdentity @relation(fields: [identityId], references: [id])
  sourceHospitalId    String
  sourceHospital      Hospital         @relation("EmergencySourceHospital", fields: [sourceHospitalId], references: [id])
  accessingHospitalId String
  accessingHospital   Hospital         @relation("EmergencyAccessingHospital", fields: [accessingHospitalId], references: [id])
  referralId          String?
  referral            Referral?        @relation(fields: [referralId], references: [id])
  grantedById         String
  grantedBy           StaffMember      @relation(fields: [grantedById], references: [id])
  reason              String
  recordCategories    String[]
  createdAt           DateTime         @default(now())
  expiresAt           DateTime
  endedAt             DateTime?

  @@index([identityId, accessingHospitalId, endedAt])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Visits — everything clinical hangs off one of these.
// ---------------------------------------------------------------------------

enum VisitStatus {
  OPEN
  CLOSED
}

model Visit {
  id                  String       @id @default(cuid())
  hospitalId          String
  hospital            Hospital     @relation(fields: [hospitalId], references: [id])
  patientId           String
  patient             Patient      @relation(fields: [patientId], references: [id])
  openedAt            DateTime     @default(now())
  openedById          String?
  openedBy            StaffMember? @relation("VisitOpenedBy", fields: [openedById], references: [id])
  closedAt            DateTime?
  status              VisitStatus  @default(OPEN)
  presentingComplaint String?
  followUpDate        DateTime?
  followUpNote        String?

  requests         Request[]
  vitals           VitalsRecord[]
  notes            ClinicalNote[]
  labResults       LabResult[]
  prescriptions    Prescription[]
  diagnoses        Diagnosis[]
  aiArtifacts      AiArtifact[]
  referrals        Referral[]
  clinicalInsights ClinicalInsight[]
  invoices         Invoice[]

  @@unique([hospitalId, id])
  @@index([patientId])
  @@index([hospitalId, patientId])
}

// ---------------------------------------------------------------------------
// Appointments — booked from the patient record or a department workspace.
// ---------------------------------------------------------------------------

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id           String            @id @default(cuid())
  hospitalId   String
  hospital     Hospital          @relation(fields: [hospitalId], references: [id])
  patientId    String
  patient      Patient           @relation(fields: [patientId], references: [id])
  departmentId String?
  department   Department?       @relation(fields: [departmentId], references: [id])
  scheduledFor DateTime
  reason       String
  status       AppointmentStatus @default(SCHEDULED)
  notes        String?
  createdById  String
  createdBy    StaffMember       @relation(fields: [createdById], references: [id])
  createdAt    DateTime          @default(now())

  @@index([patientId])
  @@index([scheduledFor])
  @@index([hospitalId, scheduledFor])
}

// ---------------------------------------------------------------------------
// Communications — simulated WhatsApp/Email, logged permanently on the record.
// No provider is connected yet; a real one slots in behind the same SENT ->
// DELIVERED state machine without changing the interface.
// ---------------------------------------------------------------------------

enum CommunicationChannel {
  WHATSAPP
  EMAIL
}

enum CommunicationStatus {
  SENT
  DELIVERED
}

model Communication {
  id           String               @id @default(cuid())
  hospitalId   String
  hospital     Hospital             @relation(fields: [hospitalId], references: [id])
  patientId    String
  patient      Patient              @relation(fields: [patientId], references: [id])
  channel      CommunicationChannel
  templateUsed String?
  subject      String? // email only
  body         String
  status       CommunicationStatus  @default(SENT)
  sentById     String
  sentBy       StaffMember          @relation(fields: [sentById], references: [id])
  sentAt       DateTime             @default(now())
  deliveredAt  DateTime?

  @@index([patientId])
  @@index([hospitalId, patientId])
}

// ---------------------------------------------------------------------------
// Requests — the inter-department routing mechanism.
// ---------------------------------------------------------------------------

enum RequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  QUERIED
}

enum RequestUrgency {
  ROUTINE
  URGENT
  EMERGENCY
}

model Request {
  id         String   @id @default(cuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  visitId    String
  visit      Visit    @relation(fields: [visitId], references: [id])

  fromDepartmentId String
  fromDepartment   Department @relation("RequestFromDepartment", fields: [fromDepartmentId], references: [id])
  toDepartmentId   String
  toDepartment     Department @relation("RequestToDepartment", fields: [toDepartmentId], references: [id])

  requestedById String
  requestedBy   StaffMember  @relation("RequestedBy", fields: [requestedById], references: [id])
  fulfilledById String?
  fulfilledBy   StaffMember? @relation("FulfilledBy", fields: [fulfilledById], references: [id])

  requestType String // "Full Blood Count", "Vitals Check", "Clinical Review", admin/department-defined
  reason      String
  urgency     RequestUrgency @default(ROUTINE)
  status      RequestStatus  @default(PENDING)

  queryNote String? // set when status = QUERIED

  outcome        Json? // free-form outcome for departments without a dedicated model (admin-defined resultFields)
  outcomeSummary String? // short human-readable line shown in queues/history for any outcome type

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  labResults    LabResult[]
  notifications Notification[]

  @@unique([hospitalId, id])
  @@index([visitId])
  @@index([toDepartmentId, status])
  @@index([hospitalId, toDepartmentId, status])
}

model Referral {
  id                      String                 @id @default(cuid())
  identityId              String
  identity                CareNexaIdentity       @relation(fields: [identityId], references: [id])
  patientId               String
  patient                 Patient                @relation(fields: [patientId], references: [id])
  sourceVisitId           String?
  sourceVisit             Visit?                 @relation(fields: [sourceVisitId], references: [id])
  sourceHospitalId        String
  sourceHospital          Hospital               @relation("ReferralSourceHospital", fields: [sourceHospitalId], references: [id])
  destinationHospitalId   String
  destinationHospital     Hospital               @relation("ReferralDestinationHospital", fields: [destinationHospitalId], references: [id])
  sourceDepartmentId      String?
  sourceDepartment        Department?            @relation("ReferralSourceDepartment", fields: [sourceDepartmentId], references: [id])
  destinationDepartmentId String?
  destinationDepartment   Department?            @relation("ReferralDestinationDepartment", fields: [destinationDepartmentId], references: [id])
  referringStaffId        String
  referringStaff          StaffMember            @relation(fields: [referringStaffId], references: [id])
  reason                  String
  urgency                 RequestUrgency         @default(ROUTINE)
  requestedService        String
  clinicalInformation     Json
  status                  ReferralStatus         @default(DRAFT)
  appointmentScheduledFor DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  submittedAt             DateTime?
  events                  ReferralEvent[]
  accessGrants            PatientAccessGrant[]
  emergencyAccessEvents   EmergencyAccessEvent[]

  @@index([sourceHospitalId, status, createdAt])
  @@index([destinationHospitalId, status, createdAt])
  @@index([identityId])
  @@index([patientId])
  @@index([sourceVisitId])
}

model ReferralEvent {
  id         String         @id @default(cuid())
  referralId String
  referral   Referral       @relation(fields: [referralId], references: [id])
  actorId    String
  actor      StaffMember    @relation(fields: [actorId], references: [id])
  status     ReferralStatus
  detail     String?
  createdAt  DateTime       @default(now())

  @@index([referralId, createdAt])
}

// ---------------------------------------------------------------------------
// Notifications — written from the request lifecycle, read by polling.
// ---------------------------------------------------------------------------

model Notification {
  id         String   @id @default(cuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  type       String // "REQUEST_INCOMING" | "REQUEST_COMPLETED" | "REQUEST_QUERIED"
  message    String

  departmentId String? // notify anyone currently in this department (incoming work)
  department   Department?  @relation(fields: [departmentId], references: [id])
  staffId      String? // notify this specific person (their own request was answered)
  staff        StaffMember? @relation(fields: [staffId], references: [id])

  requestId String?
  request   Request? @relation(fields: [requestId], references: [id])

  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([departmentId, readAt])
  @@index([staffId, readAt])
  @@index([hospitalId, departmentId, readAt])
}

// ---------------------------------------------------------------------------
// Clinical records attached to a visit
// ---------------------------------------------------------------------------

model VitalsRecord {
  id           String      @id @default(cuid())
  visitId      String
  visit        Visit       @relation(fields: [visitId], references: [id])
  recordedById String
  recordedBy   StaffMember @relation(fields: [recordedById], references: [id])
  recordedAt   DateTime    @default(now())

  systolicBp      Int?
  diastolicBp     Int?
  temperatureC    Float?
  pulseBpm        Int?
  respiratoryRate Int?
  weightKg        Float?
  heightCm        Float?

  @@index([visitId])
}

model ClinicalNote {
  id        String      @id @default(cuid())
  visitId   String
  visit     Visit       @relation(fields: [visitId], references: [id])
  authorId  String
  author    StaffMember @relation(fields: [authorId], references: [id])
  createdAt DateTime    @default(now())

  shorthand    String? // clinician's raw shorthand input, if AI-assisted
  content      String // final structured note
  isAiAssisted Boolean   @default(false)
  signedAt     DateTime?

  @@index([visitId])
}

enum LabResultType {
  NUMERIC
  QUALITATIVE
}

model LabResult {
  id          String      @id @default(cuid())
  visitId     String
  visit       Visit       @relation(fields: [visitId], references: [id])
  requestId   String?
  request     Request?    @relation(fields: [requestId], references: [id])
  enteredById String
  enteredBy   StaffMember @relation(fields: [enteredById], references: [id])
  enteredAt   DateTime    @default(now())

  testName         String // "Fasting Blood Glucose", "Malaria Parasite"
  resultType       LabResultType @default(NUMERIC)
  value            Float? // set when resultType = NUMERIC
  qualitativeValue String? // set when resultType = QUALITATIVE, e.g. "Positive", "Non-reactive"
  unit             String // "mg/dL", or "" for qualitative tests
  referenceLow     Float?
  referenceHigh    Float?
  isAbnormal       Boolean       @default(false)

  @@index([visitId])
  @@index([testName])
}

model Diagnosis {
  id           String      @id @default(cuid())
  visitId      String
  visit        Visit       @relation(fields: [visitId], references: [id])
  recordedById String
  recordedBy   StaffMember @relation(fields: [recordedById], references: [id])
  createdAt    DateTime    @default(now())

  description String
  plan        String

  @@index([visitId])
}

enum PrescriptionStatus {
  PENDING
  DISPENSED
}

model Prescription {
  id             String      @id @default(cuid())
  visitId        String
  visit          Visit       @relation(fields: [visitId], references: [id])
  prescribedById String
  prescribedBy   StaffMember @relation(fields: [prescribedById], references: [id])
  createdAt      DateTime    @default(now())

  drugName  String
  dosage    String // "500mg"
  frequency String // "TDS", "BD", "OD"
  duration  String // "5 days"
  status    PrescriptionStatus @default(PENDING)

  dispensation Dispensation?

  @@index([visitId])
}

model Dispensation {
  id             String       @id @default(cuid())
  prescriptionId String       @unique
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  dispensedById  String
  dispensedBy    StaffMember  @relation(fields: [dispensedById], references: [id])
  dispensedAt    DateTime     @default(now())
  quantity       String
  note           String?
}

// ---------------------------------------------------------------------------
// AI layer — every generated artifact stored with attribution + approval.
// ---------------------------------------------------------------------------

enum AiArtifactType {
  HISTORY_SUMMARY
  RESULT_CONTEXT
  NOTE_ASSISTANCE
  DISCHARGE_SUMMARY
  REFERRAL_LETTER
  CV_SCREENING
}

model AiArtifact {
  id            String         @id @default(cuid())
  hospitalId    String
  hospital      Hospital       @relation(fields: [hospitalId], references: [id])
  type          AiArtifactType
  visitId       String?
  visit         Visit?         @relation(fields: [visitId], references: [id])
  applicationId String?
  application   Application?   @relation(fields: [applicationId], references: [id])

  model     String // model id used
  input     Json // structured input snapshot for reproducibility
  output    Json // structured output (summary text, score+reasoning, etc.)
  createdAt DateTime @default(now())

  requiresApproval Boolean      @default(false)
  approvedById     String?
  approvedBy       StaffMember? @relation("AiArtifactApprovedBy", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  provider         String       @default("ANTHROPIC")
  promptVersion    String?
  generatedById    String?
  generatedBy      StaffMember? @relation("AiArtifactGeneratedBy", fields: [generatedById], references: [id])

  @@index([visitId])
  @@index([applicationId])
  @@index([hospitalId, createdAt])
}

model ClinicalInsight {
  id             String              @id @default(cuid())
  hospitalId     String
  hospital       Hospital            @relation(fields: [hospitalId], references: [id])
  identityId     String?
  identity       CareNexaIdentity?   @relation(fields: [identityId], references: [id])
  patientId      String
  patient        Patient             @relation(fields: [patientId], references: [id])
  visitId        String?
  visit          Visit?              @relation(fields: [visitId], references: [id])
  type           ClinicalInsightType
  title          String
  summary        String
  evidence       Json
  model          String
  provider       String
  promptVersion  String
  requiresReview Boolean             @default(true)
  reviewedById   String?
  reviewedBy     StaffMember?        @relation("ClinicalInsightReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  dismissedAt    DateTime?
  createdAt      DateTime            @default(now())

  @@index([hospitalId, patientId, createdAt])
  @@index([identityId])
  @@index([visitId])
}

// ---------------------------------------------------------------------------
// Recruitment
// ---------------------------------------------------------------------------

enum VacancyStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model Vacancy {
  id             String        @id @default(cuid())
  hospitalId     String
  hospital       Hospital      @relation(fields: [hospitalId], references: [id])
  title          String
  departmentId   String?
  department     Department?   @relation(fields: [departmentId], references: [id])
  description    String
  requirements   String[] // discrete requirement lines the AI screens CVs against
  employmentType String // "Full-time", "Locum"
  location       String
  status         VacancyStatus @default(DRAFT)
  publishedAt    DateTime?
  closedAt       DateTime?
  createdAt      DateTime      @default(now())

  applications Application[]

  @@index([hospitalId, status])
}

enum ApplicationStage {
  APPLIED
  SCREENED
  SHORTLISTED
  INTERVIEWED
  HIRED
  REJECTED
}

model Candidate {
  id         String   @id @default(cuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  fullName   String
  email      String
  phone      String
  createdAt  DateTime @default(now())

  applications Application[]
  hiredAsStaff StaffMember?

  @@index([hospitalId, email])
}

model Application {
  id          String    @id @default(cuid())
  hospitalId  String
  hospital    Hospital  @relation(fields: [hospitalId], references: [id])
  vacancyId   String
  vacancy     Vacancy   @relation(fields: [vacancyId], references: [id])
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id])

  cvFileName     String? // original filename, e.g. "jane-doe-cv.pdf"
  cvFileMimeType String? // application/pdf, application/msword, or the docx MIME type
  cvFileData     Bytes? // the uploaded file itself — served back via the CV download route
  cvText         String? // legacy: pasted CV text from before file upload existed; screened by AI as a fallback
  coverNote      String?
  stage          ApplicationStage @default(APPLIED)
  appliedAt      DateTime         @default(now())

  screeningScore        Int?
  screeningReasoning    String?
  screeningOverrideNote String?

  interview   Interview?
  aiArtifacts AiArtifact[]

  @@index([vacancyId, stage])
  @@index([hospitalId, vacancyId, stage])
}

model Interview {
  id            String      @id @default(cuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id])
  scheduledFor  DateTime
  outcome       String? // recorded after the interview
  createdAt     DateTime    @default(now())
}

// ---------------------------------------------------------------------------
// Billing — patient bills and payments, per hospital. Amounts in kobo (NGN).
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  INSURANCE
}

model Invoice {
  id          String        @id @default(cuid())
  hospitalId  String
  hospital    Hospital      @relation(fields: [hospitalId], references: [id])
  number      String // e.g. INV-2026-00012, unique within the hospital
  patientId   String
  patient     Patient       @relation(fields: [patientId], references: [id])
  visitId     String?
  visit       Visit?        @relation(fields: [visitId], references: [id])
  status      InvoiceStatus @default(UNPAID)
  note        String?
  createdById String
  createdBy   StaffMember   @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  voidedAt    DateTime?

  items    InvoiceItem[]
  payments Payment[]

  @@unique([hospitalId, number])
  @@index([hospitalId, status, createdAt])
  @@index([patientId])
}

model InvoiceItem {
  id            String  @id @default(cuid())
  invoiceId     String
  invoice       Invoice @relation(fields: [invoiceId], references: [id])
  description   String
  quantity      Int     @default(1)
  unitPriceKobo Int

  @@index([invoiceId])
}

model Payment {
  id           String        @id @default(cuid())
  invoiceId    String
  invoice      Invoice       @relation(fields: [invoiceId], references: [id])
  amountKobo   Int
  method       PaymentMethod
  reference    String?
  receivedById String
  receivedBy   StaffMember   @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  receivedAt   DateTime      @default(now())

  @@index([invoiceId])
}
