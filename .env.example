# Supabase Postgres connection string.
# Use the DIRECT connection string (Project Settings -> Database -> Connection string -> "URI"),
# not the pgbouncer transaction-pooler one — Prisma Migrate needs a direct connection,
# and this demo's traffic is far below what pooling exists for.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Anthropic Claude API key (for AI layer — summaries, note assistance, CV screening).
ANTHROPIC_API_KEY=""

# Session secret for signing auth cookies.
AUTH_SECRET=""
