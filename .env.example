# App runtime connection (Project Settings -> Database -> Connection string -> "Transaction pooler").
# Required in production: serverless functions each open their own DB connection, and only
# the transaction pooler (port 6543, pgbouncer=true) multiplexes enough of those to survive
# real traffic on Supabase's connection cap. Using the session pooler or a direct connection
# here will intermittently fail in production with "max clients reached" once there's more
# than a handful of concurrent requests.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-POOLER-HOST]:6543/postgres?pgbouncer=true"

# Migrations-only connection (Project Settings -> Database -> Connection string -> "Session pooler",
# or the direct URI if reachable from your network). `prisma migrate` needs a stable session
# (advisory locks, DDL) that the transaction pooler doesn't support — this is CLI-only, never
# used by the running app.
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-POOLER-HOST]:5432/postgres"

# Anthropic Claude API key (for AI layer — summaries, note assistance, CV screening).
ANTHROPIC_API_KEY=""

# OpenAI API key (for clinical insights and risk observations).
OPENAI_API_KEY=""
OPENAI_MODEL_CLINICAL="gpt-4.1-mini"

# Session secret for signing auth cookies.
AUTH_SECRET=""

# Prototype presentation only: shows the master demo account on /login.
# DEMO_MODE="true"
# DEMO_EMAIL="platform-admin@carenexa.cloud"
# DEMO_PASSWORD="carenexa2026"
